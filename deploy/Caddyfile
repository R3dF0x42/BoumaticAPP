https://{$PUBLIC_DOMAIN} {
	tls {
		issuer acme https://acme-v02.api.letsencrypt.org/directory
	}

	encode zstd gzip
	header X-Content-Type-Options nosniff

	@backend path /api /api/* /uploads /uploads/*
	handle @backend {
		reverse_proxy backend:4000
	}

	handle {
		reverse_proxy frontend:8080
	}
}
