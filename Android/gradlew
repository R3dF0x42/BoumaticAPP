#!/bin/sh
set -eu
APP_HOME=$(CDPATH='' cd -- "$(dirname -- "$0")" && pwd)
JAVA_EXE=java
if [ -n "${JAVA_HOME:-}" ]; then
    JAVA_EXE="$JAVA_HOME/bin/java"
fi
if ! "$JAVA_EXE" -version >/dev/null 2>&1; then
    printf '%s\n' 'Java introuvable. Configurer JAVA_HOME avec un JDK 17 ou 21.' >&2
    exit 1
fi
exec "$JAVA_EXE" -classpath "$APP_HOME/gradle/wrapper/gradle-wrapper.jar" org.gradle.wrapper.GradleWrapperMain "$@"
